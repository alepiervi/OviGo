# ===== OVIGO: impostazioni del server =====
# Copia questo file come ".env" e compila i valori. Non caricare mai il file .env su GitHub.

# Database MongoDB (su Emergent sono già impostati: non toccarli)
MONGO_URL=mongodb://localhost:27017
DB_NAME=ovigo

# Indirizzo pubblico del sito, usato nei link delle email (es. https://www.ovigo.it)
PUBLIC_URL=

# Chiave segreta per i login (facoltativa): una frase lunga e casuale. Se la lasci vuota il server ne crea una da solo.
JWT_SECRET=

# Primo amministratore: creato al primo avvio se non esiste già
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email automatiche con Brevo (brevo.com > SMTP & API > API keys)
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=OVIGO

# Domini che possono chiamare il server (lascia * se sito e server sono sullo stesso dominio)
CORS_ORIGINS=*

# true = al primo avvio carica agenzie, tour e clienti di prova (solo per presentazioni, MAI in produzione)
SEED_DEMO=false
DEMO_PASSWORD=Ovigo2026!
